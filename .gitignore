# Only the templates and tools that generate the graphics/videos; media stays local.
/*
!/.gitignore
!/index.html
!/maker.html
!/recover.html
!/logo.jpg
!/14starlogo.jpg
!/sync.py
!/db.js
!/.github/
!/matchday/
!/teamlist/
!/live/
!/Sponsors/
/Sponsors/*
!/Sponsors/sponsors.txt
!/Sponsors/web/
!/highlights/
/matchday/out/
/teamlist/*.png
/highlights/*
!/highlights/*.html
!/highlights/*.py
!/seasons/
/seasons/*/graphics/
!/supabase/
!/CLAUDE.md
# New multi-organiser app (Vite build, Cloudflare Pages)
!/app/
/app/node_modules/
/app/dist/
/app/dev-dist/
# MediaPipe wasm, copied from node_modules by `npm run build` (Story 2.5)
/app/public/mediapipe/vision_wasm_internal.*
/app/.env*
# BMAD method and skills (planning output stays private, in its own repo)
!/_bmad/
!/.claude/
/.claude/*
!/.claude/skills/
