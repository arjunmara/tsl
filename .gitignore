# Only the templates and tools that generate the graphics/videos; media stays local.
/*
!/.gitignore
!/index.html
!/maker.html
!/recover.html
!/logo.jpg
!/14starlogo.jpg
!/sync.py
!/db.js
!/.github/
!/matchday/
!/teamlist/
!/live/
!/Sponsors/
/Sponsors/*
!/Sponsors/sponsors.txt
!/Sponsors/web/
!/highlights/
/matchday/out/
/teamlist/*.png
/highlights/*
!/highlights/*.html
!/highlights/*.py
!/seasons/
/seasons/*/graphics/
!/supabase/
!/CLAUDE.md
# BMAD method and skills (planning output stays private, in its own repo)
!/_bmad/
!/.claude/
/.claude/*
!/.claude/skills/
